<?xml version="1.0"?>
<robot name="yeah_hand" xmlns:xacro="http://ros.org">
<xacro:macro name="fixed_component" params="component_name mesh_filename parent x y z roll pitch yaw mass:=0">

<link name="${component_name}">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://yeah_hand_description/meshes/${mesh_filename}.dae"/>
    </geometry>
    <material name="gray"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://yeah_hand_description/meshes/${mesh_filename}.dae"/>
    </geometry>
  </collision>
  <!-- Center of mass at the wrist center, inertia of a solid box
       with the hand body envelope (see yeah_hand.xacro) -->
  <inertial>
    <origin xyz="${hand_com_x} ${hand_com_y} ${hand_com_z}" rpy="0 0 0"/>
    <mass value="${mass}"/>
    <inertia ixx="${mass / 12.0 * (hand_box_y**2 + hand_box_z**2)}" ixy="0" ixz="0"
             iyy="${mass / 12.0 * (hand_box_x**2 + hand_box_z**2)}" iyz="0"
             izz="${mass / 12.0 * (hand_box_x**2 + hand_box_y**2)}"/>
  </inertial>
</link>
<joint name="${component_name}_joint" type="fixed">
  <parent link="${parent}"/>
  <child link="${component_name}"/>
  <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
</joint>
</xacro:macro>
</robot>
